DATABASE_URL=postgresql://phishshield:local-development-only@127.0.0.1:5440/phishshield_sales
POSTGRES_PASSWORD=local-development-only
APP_ORIGIN=http://127.0.0.1:3000
# Defina uma senha com pelo menos 12 caracteres antes de executar db:seed.
SEED_PASSWORD=

# Etapa 4: desativada até configuração e política aprovadas. Não compartilhe a chave.
AI_ENABLED=false
AI_POLICY_APPROVED=false
OPENAI_API_KEY=
# Escolha um modelo com suporte a Responses e Structured Outputs.
OPENAI_MODEL=
# Preços verificados do modelo, em USD por milhão de tokens (entrada/saída).
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
AI_DAILY_BUDGET_USD=1
AI_DAILY_REQUEST_LIMIT=20

# Redação: independente da análise de conversas. Claude é a primeira opção.
WRITING_DEFAULT_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_WRITING_ENABLED=false
CLAUDE_WRITING_POLICY_APPROVED=false
CLAUDE_WRITING_MODEL=
CLAUDE_WRITING_INPUT_USD_PER_MILLION=
CLAUDE_WRITING_OUTPUT_USD_PER_MILLION=
CLAUDE_WRITING_DAILY_BUDGET_USD=1
CLAUDE_WRITING_DAILY_REQUEST_LIMIT=20

# Alternativa selecionada manualmente. Reutiliza OPENAI_API_KEY, com modelo próprio.
OPENAI_WRITING_ENABLED=false
OPENAI_WRITING_POLICY_APPROVED=false
OPENAI_WRITING_MODEL=
OPENAI_WRITING_INPUT_USD_PER_MILLION=
OPENAI_WRITING_OUTPUT_USD_PER_MILLION=
OPENAI_WRITING_DAILY_BUDGET_USD=1
OPENAI_WRITING_DAILY_REQUEST_LIMIT=20
